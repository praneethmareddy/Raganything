package com.demo.simple_demo

rule "CIQ to ACPF and Serverinfo"
when
    $ciq : CIQRow()
then
    ACPFConfig acpf = new ACPFConfig();
    acpf.setNeId($ciq.getNeId());
    acpf.setNeName($ciq.getNeName());
    acpf.setNeType($ciq.getNeType());

    ServerInfoConfig srv = new ServerInfoConfig();
    srv.setNeId($ciq.getNeId());
    srv.setNeName($ciq.getNeName());
    srv.setNeType($ciq.getNeType());

    insert(acpf);
    insert(srv);
end
