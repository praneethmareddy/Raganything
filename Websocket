# server.py
import asyncio
from fastapi import FastAPI, WebSocket
from fastapi.middleware.cors import CORSMiddleware

from websocket import manager

app = FastAPI()

# allow Streamlit frontend calls
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/health")
def health():
    return {"status": "ok"}


@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    """
    WebSocket endpoint.
    Streamlit connects here and keeps connection alive.
    """
    await manager.connect(websocket)
    try:
        while True:
            # keep connection alive (client sends ping)
            await websocket.receive_text()
    except Exception:
        manager.disconnect(websocket)


@app.post("/start")
async def start_workflow():
    """
    Dummy workflow.
    Every 3 seconds send progress updates via websocket.
    """

    steps = [
        ("Step 1: Validating input...", 20),
        ("Step 2: Loading documents...", 40),
        ("Step 3: Running embeddings...", 60),
        ("Step 4: Querying vector DB...", 80),
        ("Step 5: Generating final answer...", 100),
    ]

    for msg, pct in steps:
        await asyncio.sleep(3)
        await manager.broadcast(
            {
                "type": "progress",
                "message": msg,
                "percent": pct,
            }
        )

    await manager.broadcast(
        {
            "type": "final",
            "message": "✅ All tasks have been completed!",
            "result": "Here is your final chatbot response (dummy output).",
        }
    )

    return {"status": "started"}


