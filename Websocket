# streamlit.py
import streamlit as st
import requests
import json
import threading
import time
import websocket  # websocket-client

BACKEND_HTTP = "http://127.0.0.1:8000"
BACKEND_WS = "ws://127.0.0.1:8000/ws"

st.set_page_config(page_title="Progress Stream Demo", layout="centered")
st.title("🔥 Streamlit + FastAPI WebSocket Progress Demo")

# session state init
if "progress" not in st.session_state:
    st.session_state.progress = 0

if "status_text" not in st.session_state:
    st.session_state.status_text = "Click Start"

if "final_result" not in st.session_state:
    st.session_state.final_result = ""

if "ws_started" not in st.session_state:
    st.session_state.ws_started = False


# UI widgets
progress_bar = st.progress(st.session_state.progress)
status_box = st.info(st.session_state.status_text)

if st.session_state.final_result:
    st.success(st.session_state.final_result)


def ws_listener():
    """
    WebSocket listener in background thread.
    Updates st.session_state values.
    """

    def on_message(ws, message):
        data = json.loads(message)

        if data.get("type") == "progress":
            st.session_state.progress = int(data.get("percent", 0))
            st.session_state.status_text = data.get("message", "")

        elif data.get("type") == "final":
            st.session_state.progress = 100
            st.session_state.status_text = data.get("message", "")
            st.session_state.final_result = data.get("result", "")

    def on_open(ws):
        # send ping to keep alive
        ws.send("ping")

    ws = websocket.WebSocketApp(
        BACKEND_WS,
        on_open=on_open,
        on_message=on_message,
    )

    ws.run_forever()


if st.button("▶ Start Workflow"):
    # reset UI
    st.session_state.progress = 0
    st.session_state.status_text = "Starting workflow..."
    st.session_state.final_result = ""

    # start websocket thread only once
    if not st.session_state.ws_started:
        t = threading.Thread(target=ws_listener, daemon=True)
        t.start()
        st.session_state.ws_started = True

    # trigger backend workflow
    requests.post(f"{BACKEND_HTTP}/start")


# refresh loop (so UI updates when session_state changes)
# (Streamlit doesn't auto-refresh on background thread updates)
for _ in range(60):
    time.sleep(0.5)
    # stop refreshing if final result already arrived
    if st.session_state.final_result:
        break
    st.rerun()


